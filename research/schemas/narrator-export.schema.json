{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narrator-export.schema.json",
  "title": "AI Narrator Export v2",
  "description": "Self-contained JSON export for AI narrators hosting fantasy-meets-reality adventures. Includes atmosphere, sensory data, adventure hooks, and fantasy integration layer.",
  "type": "object",
  "required": ["export_metadata", "narrator_system_prompt", "eras", "entries", "people", "places", "environment_features", "adventure_hooks", "fantasy_layer", "hazards"],
  "properties": {
    "export_metadata": {
      "type": "object",
      "required": ["setting", "generated_at", "entry_count", "version"],
      "properties": {
        "setting": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "entry_count": { "type": "integer", "minimum": 0 },
        "version": { "type": "string" }
      }
    },
    "narrator_system_prompt": { "type": "string" },
    "eras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "start", "end", "context_summary", "atmosphere"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "context_summary": { "type": "string" },
          "atmosphere": {
            "type": "object",
            "required": ["mood", "soundscape"],
            "properties": {
              "mood": { "type": "string" },
              "visual_palette": { "type": "string" },
              "soundscape": { "type": "string" },
              "smells": { "type": "string" },
              "social_dynamics": { "type": "string" },
              "daily_life": { "type": "string" },
              "tensions": { "type": "string" }
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "date_start", "era", "layers", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "date_start": { "type": "string" },
          "date_end": { "type": "string" },
          "era": { "type": "string" },
          "layers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": { "type": "string" },
          "details": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "people": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "role"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "role": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "places": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "type"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "type": { "type": "string" },
                "coordinates": {
                  "type": "object",
                  "properties": {
                    "lat": { "type": "number" },
                    "lng": { "type": "number" }
                  }
                },
                "description": { "type": "string" }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "type"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          },
          "narrator_notes": { "type": "string" }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "role"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "birth_year": { "type": "string" },
          "death_year": { "type": "string" },
          "description": { "type": "string" },
          "role": { "type": "string" },
          "personality": { "type": "string" },
          "motivation": { "type": "string" },
          "speech_style": { "type": "string" },
          "relationships": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "secrets": { "type": "string" },
          "adventure_role": {
            "type": "string",
            "enum": ["quest_giver", "ally", "antagonist", "mentor", "trickster", "guardian", "witness", "authority_figure", "victim", "survivor"]
          },
          "related_entry_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "coordinates": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            }
          },
          "description": { "type": "string" },
          "sensory": {
            "type": "object",
            "properties": {
              "default": {
                "type": "object",
                "properties": {
                  "sight": { "type": "string" },
                  "sound": { "type": "string" },
                  "smell": { "type": "string" },
                  "notable_features": { "type": "string" }
                }
              },
              "by_era": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          },
          "spatial": {
            "type": "object",
            "properties": {
              "adjacent_places": {
                "type": "array",
                "items": { "type": "string" }
              },
              "visibility": {
                "type": "array",
                "items": { "type": "string" }
              },
              "travel_notes": { "type": "string" }
            }
          },
          "related_entry_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "environment_features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "description", "time_relevance"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "time_relevance": { "type": "string" }
        }
      }
    },
    "adventure_hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "description"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["mystery", "conflict", "discovery", "survival", "moral_dilemma", "time_echo"]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "related_entries": {
            "type": "array",
            "items": { "type": "string" }
          },
          "related_places": {
            "type": "array",
            "items": { "type": "string" }
          },
          "era_range": {
            "type": "array",
            "items": { "type": "string" }
          },
          "fantasy_potential": { "type": "string" }
        }
      }
    },
    "fantasy_layer": {
      "type": "object",
      "properties": {
        "temporal_anomalies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["location", "description"],
            "properties": {
              "location": { "type": "string" },
              "description": { "type": "string" },
              "eras_affected": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "liminal_spaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "locations": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "historical_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["period", "description"],
            "properties": {
              "period": { "type": "string" },
              "description": { "type": "string" },
              "fantasy_potential": { "type": "string" }
            }
          }
        },
        "unexplained_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fact"],
            "properties": {
              "fact": { "type": "string" },
              "fantasy_potential": { "type": "string" }
            }
          }
        }
      }
    },
    "hazards": {
      "type": "object",
      "properties": {
        "natural": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description", "severity"],
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "severity": { "type": "string", "enum": ["low", "moderate", "high", "extreme"] },
              "eras": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description", "severity"],
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "severity": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
              "eras": { "type": "array", "items": { "type": "string" } },
              "narrator_note": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
